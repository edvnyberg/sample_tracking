<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <record id="module_category_sample_tracking" model="ir.module.category">
        <field name="name">Sample Tracking</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sample_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_sample_tracking"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sample_logistics" model="res.groups">
        <field name="name">Logistics</field>
        <field name="category_id" ref="module_category_sample_tracking"/>
        <field name="implied_ids" eval="[(4, ref('group_sample_user'))]"/>
    </record>

    <record id="group_sample_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_sample_tracking"/>
        <field name="implied_ids" eval="[(4, ref('group_sample_user'))]"/>
    </record>

    <!-- Record rules: users can only write lines they are responsible for -->
    <record id="rule_sample_line_user_write" model="ir.rule">
        <field name="name">Sample Line: Users manage their own items</field>
        <field name="model_id" ref="model_test_sample_line"/>
        <field name="groups" eval="[(4, ref('group_sample_user'))]"/>
        <field name="domain_force">['|', ('responsible_id', '=', user.id), ('responsible_id', '=', False)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Logistics can write all items in the states they are responsible for -->
    <record id="rule_sample_line_logistics_write" model="ir.rule">
        <field name="name">Sample Line: Logistics manage incoming and pending returns</field>
        <field name="model_id" ref="model_test_sample_line"/>
        <field name="groups" eval="[(4, ref('group_sample_logistics'))]"/>
        <field name="domain_force">[('state', 'in', ['incoming', 'received', 'pending_return'])]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sample_line_manager_write" model="ir.rule">
        <field name="name">Sample Line: Managers have full access</field>
        <field name="model_id" ref="model_test_sample_line"/>
        <field name="groups" eval="[(4, ref('group_sample_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</data></odoo>
