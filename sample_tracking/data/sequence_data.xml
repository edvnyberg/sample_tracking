<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">

    <record id="seq_test_sample" model="ir.sequence">
        <field name="name">Test Sample</field>
        <field name="code">test.sample</field>
        <field name="prefix">SMPL/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_test_sample_line" model="ir.sequence">
        <field name="name">Test Sample Item</field>
        <field name="code">test.sample.line</field>
        <field name="prefix">ITEM/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

</data></odoo>
