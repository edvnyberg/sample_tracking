<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <record id="view_test_sample_bulk_receive_from_list_wizard_form" model="ir.ui.view">
        <field name="name">test.sample.bulk.receive.from.list.wizard.form</field>
        <field name="model">test.sample.bulk.receive.from.list.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Receive &amp; Inspect">
                <sheet>
                    <div class="alert alert-info mb-3" role="alert">
                        Review each item below. Adjust <strong>Received</strong> if it differs from
                        what was ordered and add a note. Check <strong>Damaged</strong> and fill in
                        <strong>Damage Notes</strong> for any physically damaged items.
                    </div>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="line_id" column_invisible="1"/>
                            <field name="product_name" readonly="1" string="Item"/>
                            <field name="ordered_quantity" readonly="1" string="Ordered"/>
                            <field name="quantity" string="Received"/>
                            <field name="is_damaged" string="Damaged"/>
                            <field name="discrepancy_note" string="Discrepancy Notes"
                                   placeholder="Describe quantity difference"
                                   optional="show"/>
                            <field name="inspection_notes" string="Damage Notes"
                                   placeholder="Describe damage"
                                   optional="show"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Receive All"
                            type="object" class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

</data></odoo>
