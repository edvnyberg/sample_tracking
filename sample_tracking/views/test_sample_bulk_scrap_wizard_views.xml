<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <record id="view_test_sample_bulk_scrap_wizard_form" model="ir.ui.view">
        <field name="name">test.sample.bulk.scrap.wizard.form</field>
        <field name="model">test.sample.bulk.scrap.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Scrap Items">
                <sheet>
                    <div class="alert alert-danger mb-3" role="alert">
                        <strong>Managers:</strong> checked items will be <strong>scrapped immediately</strong>.
                        <strong>Other users:</strong> a scrap approval request will be submitted for each checked item.
                        The selected approver must approve or reject each request before items are scrapped.
                        Uncheck any item you want to skip.
                    </div>
                    <group>
                        <field name="approver_id"
                               invisible="context.get('is_manager')"
                               required="not context.get('is_manager')"/>
                    </group>
                    <group string="Moving Assistance">
                        <field name="requires_help_moving"/>
                        <field name="moving_location_id" invisible="not requires_help_moving"/>
                        <field name="on_pallet" invisible="not requires_help_moving"/>
                        <field name="moving_notes" invisible="not requires_help_moving"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="include"/>
                            <field name="line_id" string="Item Ref" options="{&quot;no_create&quot;: true, &quot;no_open&quot;: true}"/>
                            <field name="product_name" readonly="1" string="Item"/>
                            <field name="customer_name" readonly="1" string="Customer"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirm Scrap" type="object" class="btn-danger oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Server action bound to the line list so "Bulk Scrap" appears in the Actions menu -->
    <record id="action_bulk_scrap_from_line_list" model="ir.actions.server">
        <field name="name">Bulk Scrap</field>
        <field name="model_id" ref="sample_tracking.model_test_sample_line"/>
        <field name="binding_model_id" ref="sample_tracking.model_test_sample_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'name': 'Bulk Scrap',
    'res_model': 'test.sample.bulk.scrap.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': dict(env.context),
}
        </field>
    </record>

</data></odoo>
