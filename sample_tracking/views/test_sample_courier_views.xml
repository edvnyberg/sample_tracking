<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <!-- Editable list view so managers can add/rename/remove couriers inline -->
    <record id="view_test_sample_courier_list" model="ir.ui.view">
        <field name="name">test.sample.courier.list</field>
        <field name="model">test.sample.courier</field>
        <field name="arch" type="xml">
            <list string="Couriers" editable="bottom">
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_test_sample_courier" model="ir.actions.act_window">
        <field name="name">Couriers</field>
        <field name="res_model">test.sample.courier</field>
        <field name="view_mode">list</field>
    </record>

</data></odoo>
