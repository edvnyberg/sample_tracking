<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <record id="view_test_sample_confirm_shipment_wizard_form" model="ir.ui.view">
        <field name="name">test.sample.confirm.shipment.wizard.form</field>
        <field name="model">test.sample.confirm.shipment.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Shipment">
                <div class="alert alert-info" role="alert">
                    Enter the courier tracking number and confirm that the item has been handed to the courier.
                    The item will be marked as <strong>Returned</strong> and the tracking number will be saved on the item record.
                    The tracking number is optional but strongly recommended.
                </div>
                <group>
                    <field name="tracking_number" placeholder="e.g. 1Z999AA10123456784"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm Shipped"
                            type="object" class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

</data></odoo>
