<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <record id="view_test_sample_location_list" model="ir.ui.view">
        <field name="name">test.sample.location.list</field>
        <field name="model">test.sample.location</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_test_sample_location_form" model="ir.ui.view">
        <field name="name">test.sample.location.form</field>
        <field name="model">test.sample.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_test_sample_location" model="ir.actions.act_window">
        <field name="name">Sample Locations</field>
        <field name="res_model">test.sample.location</field>
        <field name="view_mode">list,form</field>
    </record>

</data></odoo>
