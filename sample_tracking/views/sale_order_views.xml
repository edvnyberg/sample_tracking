<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <record id="view_sale_order_sample_button" model="ir.ui.view">
        <field name="name">sale.order.sample.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_samples"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-flask"
                    invisible="sample_count == 0">
                    <field name="sample_count" widget="statinfo" string="Samples"/>
                </button>
            </xpath>
        </field>
    </record>

</data></odoo>
