<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <record id="view_test_sample_return_wizard_form" model="ir.ui.view">
        <field name="name">test.sample.return.wizard.form</field>
        <field name="model">test.sample.return.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-info" role="alert">
                    Select how the item will be returned to the customer.
                    <strong>Customer Pickup</strong>: the customer collects the item from your facility. Logistics will be notified.
                    <strong>Ship to Customer</strong>: choose a courier and confirm the delivery address. A shipping document is generated and logistics are notified immediately.
                </div>
                <group>
                    <field name="product_name" readonly="1"/>
                    <field name="return_method"/>
                </group>

                <!-- Courier selection, only shown when shipping -->
                <group string="Shipping Details" invisible="return_method != 'ship'">
                    <field name="courier_id"/>
                    <field name="courier_account_number"/>
                    <field name="sale_order_id" readonly="1"/>
                </group>

                <!-- Delivery address, pre-filled from the customer record and fully editable -->
                <group string="Delivery Address" invisible="return_method != 'ship'">
                    <field name="ship_name"/>
                    <field name="ship_street"/>
                    <field name="ship_street2"/>
                    <field name="ship_city"/>
                    <field name="ship_zip"/>
                    <field name="ship_state_id"/>
                    <field name="ship_country_id"/>
                </group>

                <!-- Moving assistance -->
                <group string="Moving Assistance">
                    <field name="requires_help_moving"/>
                    <field name="moving_location_id" invisible="not requires_help_moving"/>
                    <field name="on_pallet" invisible="not requires_help_moving"/>
                    <field name="moving_notes" invisible="not requires_help_moving"/>
                </group>

                <footer>
                    <button name="action_confirm" string="Confirm Return" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</data></odoo>

